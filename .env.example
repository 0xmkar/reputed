# Copy to .env. Server-side only: nothing here reaches the browser.
# docs/06-testnet-runbook.md says when each value becomes available.

# Keys are raw 32-byte ECDSA hex, with or without 0x.
OPERATOR_ADDRESS=
OPERATOR_ID=
OPERATOR_KEY=
# Pays for registerCreator. On testnet use the same value as OPERATOR_KEY, since nothing funds it
# otherwise. It is the key that gets the verifier role at deploy.
VERIFIER_KEY=
# Optional. The issuer role goes to the operator when this is empty.
ISSUER_KEY=

# Test accounts, for packages/contracts/script/fund-accounts.sh and the plan's manual tests.
CREATOR_A_ADDRESS=
CREATOR_A_KEY=
CREATOR_B_ADDRESS=
CREATOR_B_KEY=
CREATOR_C_ADDRESS=
CREATOR_C_KEY=
AGENT_A1_ADDRESS=
AGENT_A1_KEY=
AGENT_A2_ADDRESS=
AGENT_A2_KEY=
AGENT_B1_ADDRESS=
AGENT_B1_KEY=
AGENT_C1_ADDRESS=
AGENT_C1_KEY=
WALLET_U_ADDRESS=
WALLET_U_KEY=

RPC_URL=https://testnet.hashio.io/api
MIRROR_NODE=https://testnet.mirrornode.hedera.com
IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713

# Printed by packages/contracts/script/deploy.sh.
CREATOR_REGISTRY=
CREDENTIAL_TOKEN_ID=
# Only for packages/contracts/script/migrate-creators.sh: the registry whose creators are copied into CREATOR_REGISTRY.
CREATOR_REGISTRY_V1=
# Printed by apps/server/scripts/create-topics.ts.
REVIEWS_TOPIC_ID=
SCORES_TOPIC_ID=

# World ID 4.0, from the Developer Portal. RP_SIGNING_KEY is shown once and is a server secret.
WORLD_RP_ID=
RP_SIGNING_KEY=
WORLD_ACTION=agent-creator-v1
# production, staging or sandbox. No default on purpose.
WORLD_ENVIRONMENT=
# 3.0 or 4.0, whichever your proofs use. No default on purpose: accepting both lets one human
# register twice.
WORLD_PROTOCOL_VERSION=

# Optional server settings, shown with their defaults.
PORT=4000
CORS_ORIGINS=http://localhost:3000
# IPs or CIDRs of proxies in front of the server, comma separated. 127.0.0.1 for a local ngrok agent.
TRUST_PROXY=
VERIFIER_DB_PATH=cache/verifier.sqlite
WORLD_API_BASE=https://developer.world.org
REVIEW_MAX_PER_HOUR=500
REVIEW_MAX_CONCURRENT=4

# Optional scorer settings. An empty SCORER_EPOCH_SECONDS uses the scoring config's value.
SCORER_DB_PATH=cache/scorer.sqlite
SCORER_EPOCH_SECONDS=
SCORER_POLL_MS=5000
SCORER_MAX_BACKFILL_EPOCHS=24
IPFS_GATEWAY=https://ipfs.io/ipfs/

# apps/web/.env.local (public values only)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_ACTION=agent-creator-v1
