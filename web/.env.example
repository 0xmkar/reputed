# Copy to .env.local. Public values only: everything here reaches the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_ACTION=agent-creator-v1

# Optional. The footer links each one only when it is set.
NEXT_PUBLIC_CREATOR_REGISTRY=
NEXT_PUBLIC_CREDENTIAL_TOKEN_ID=
NEXT_PUBLIC_SCORES_TOPIC_ID=
NEXT_PUBLIC_GITHUB_URL=https://github.com/AtmegaBuzz/reputed
